"""
RavenStack Churn Project — Phase 1: Extraction & Cleaning
==========================================================
Reads the 5 raw CSVs, combines them into one row per account,
and saves a clean dataset ready for analysis.

Jupyter Notebook version
"""

import pandas as pd
import numpy as np
from pathlib import Path

# ----------------------------------------------------------------
# 1. Setup
# ----------------------------------------------------------------


# Jupyter doesn't have __file__, so use the current working directory
OUT_PATH = Path.cwd() / "data" / "processed" / "account_analytics.csv"



# ----------------------------------------------------------------
# 2. Load the raw files
# ----------------------------------------------------------------
accounts = pd.read_csv(
    "ravenstack_accounts.csv",
    parse_dates=["signup_date"]
)

subs = pd.read_csv(
     "ravenstack_subscriptions.csv",
    parse_dates=["start_date", "end_date"]
)

usage = pd.read_csv(
    "ravenstack_feature_usage.csv",
    parse_dates=["usage_date"]
)

tickets = pd.read_csv(
    "ravenstack_support_tickets.csv",
    parse_dates=["submitted_at", "closed_at"]
)

churn_events = pd.read_csv(
    "ravenstack_churn_events.csv",
    parse_dates=["churn_date"]
)

print(
    f"Loaded: {len(accounts)} accounts, "
    f"{len(subs)} subscriptions, "
    f"{len(usage)} usage events, "
    f"{len(tickets)} tickets, "
    f"{len(churn_events)} churn events"
)

# ----------------------------------------------------------------
# 3. Subscriptions
# ----------------------------------------------------------------

subs = subs.sort_values(["account_id", "start_date"])

# Historical subscription summary
sub_summary = subs.groupby("account_id").agg(
    total_subscriptions=("subscription_id", "count"),
    lifetime_mrr_sum=("mrr_amount", "sum"),
    total_upgrades=("upgrade_flag", "sum"),
    total_downgrades=("downgrade_flag", "sum"),
    first_start_date=("start_date", "min"),
).reset_index()

# Most recent subscription = current plan
current_sub = (
    subs.groupby("account_id")
    .tail(1)
    [[
        "account_id",
        "plan_tier",
        "seats",
        "mrr_amount",
        "arr_amount",
        "billing_frequency",
        "end_date"
    ]]
    .rename(columns={
        "plan_tier": "current_plan_tier",
        "mrr_amount": "current_mrr",
        "arr_amount": "current_arr"
    })
)

# Combine subscription history + current subscription
sub_summary = sub_summary.merge(
    current_sub,
    on="account_id",
    how="left"
)

# Calculate customer tenure
sub_summary["tenure_days"] = (
    sub_summary["end_date"].fillna(TODAY)
    - sub_summary["first_start_date"]
).dt.days

# ----------------------------------------------------------------
# 4. Feature Usage
# ----------------------------------------------------------------

# Map subscription_id → account_id
sub_to_account = (
    subs[["subscription_id", "account_id"]]
    .drop_duplicates()
)

usage = usage.merge(
    sub_to_account,
    on="subscription_id",
    how="left"
)

# Aggregate usage to account level
usage_summary = usage.groupby("account_id").agg(
    total_usage_events=("usage_id", "count"),
    total_errors=("error_count", "sum"),
    distinct_features_used=("feature_name", "nunique"),
    last_usage_date=("usage_date", "max"),
).reset_index()

# Days since last usage
usage_summary["days_since_last_usage"] = (
    TODAY - usage_summary["last_usage_date"]
).dt.days

# ----------------------------------------------------------------
# 5. Support Tickets
# ----------------------------------------------------------------

ticket_summary = tickets.groupby("account_id").agg(
    total_tickets=("ticket_id", "count"),
    avg_satisfaction=("satisfaction_score", "mean"),
    escalation_count=("escalation_flag", "sum"),
).reset_index()

# ----------------------------------------------------------------
# 6. Churn Events
# ----------------------------------------------------------------

churn_events = churn_events.sort_values(
    ["account_id", "churn_date"]
)

# Most recent churn reason for each account
latest_reason = (
    churn_events.groupby("account_id")
    .tail(1)
    [["account_id", "reason_code"]]
    .rename(columns={
        "reason_code": "latest_churn_reason"
    })
)

# ----------------------------------------------------------------
# 7. Combine Everything
# ----------------------------------------------------------------

df = accounts.merge(
    sub_summary,
    on="account_id",
    how="left"
)

df = df.merge(
    usage_summary,
    on="account_id",
    how="left"
)

df = df.merge(
    ticket_summary,
    on="account_id",
    how="left"
)

df = df.merge(
    latest_reason,
    on="account_id",
    how="left"
)

# ----------------------------------------------------------------
# 8. Cleaning
# ----------------------------------------------------------------

# Columns where missing = no activity
zero_fill_cols = [
    "total_usage_events",
    "total_errors",
    "distinct_features_used",
    "total_tickets",
    "escalation_count"
]

df[zero_fill_cols] = df[zero_fill_cols].fillna(0)

# Missing churn reason means account never churned
df["latest_churn_reason"] = (
    df["latest_churn_reason"]
    .fillna("never_churned")
)

# Current churn status
df["churned"] = df["churn_flag"].astype(bool)

# Revenue currently at risk
df["revenue_at_risk_arr"] = np.where(
    df["churned"],
    df["current_arr"],
    0
)

# ----------------------------------------------------------------
# 9. Save Clean Dataset
# ----------------------------------------------------------------

OUT_PATH.parent.mkdir(
    parents=True,
    exist_ok=True
)

df.to_csv(
    OUT_PATH,
    index=False
)

# ----------------------------------------------------------------
# 10. Validation / Summary
# ----------------------------------------------------------------

print("\n" + "=" * 60)
print("CLEANING COMPLETE")
print("=" * 60)

print(f"Saved cleaned dataset → {OUT_PATH}")

print(f"\nAccounts: {len(df):,}")

print(
    f"Churn rate: {df['churned'].mean():.1%}"
)

print(
    f"Revenue at risk: "
    f"${df['revenue_at_risk_arr'].sum():,.0f}"
)

print(
    f"\nFinal dataset shape: "
    f"{df.shape[0]:,} rows × {df.shape[1]} columns"
)

print("\nFirst 5 rows:")
display(df.head())
